#include <Arduino.h>
#include <FastLED.h>

#define LED_PIN 4
#define NUM_LEDS 44

CRGB leds[NUM_LEDS];

void setup() {
  FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
  FastLED.clear();
  FastLED.show();
}

void loop() {
  for(int i = 0; i < NUM_LEDS; i++) {

    // fade in 
    for(int b = 0; b <= 255; b++) {
      leds[i] = CRGB(b, b, b); 
      FastLED.show();
      delay(5);
    }

    
    delay(100);

    // fade out 
    for(int b = 255; b >= 0; b--) {
      leds[i] = CRGB(b, b, b);
      FastLED.show();
      delay(5);
    }
  }
}