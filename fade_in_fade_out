#include <Arduino.h>
#include <FastLED.h>

#define LED_PIN 4
#define NUM_LEDS 44

CRGB leds[NUM_LEDS];

void setup() {
  FastLED.addLeds<WS2812B, LED_PIN, GRB>(leds, NUM_LEDS);
  
  for(int i = 0; i < NUM_LEDS; i++) {
    leds[i] = CRGB::White;
  }
}

void loop() {
  // z najvyššieho na najnižší jas
  for(int b = 255; b >= 0; b--) {
    FastLED.setBrightness(b);
    FastLED.show();
    delay(10);
  }

  // a späť hore (aby sa to opakovalo plynulo)
  for(int b = 0; b <= 255; b++) {
    FastLED.setBrightness(b);
    FastLED.show();
    delay(10);
  }
}